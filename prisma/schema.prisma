generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum LocaleCode {
  EN
  ZH_HANT
}

enum PublishStatus {
  DRAFT
  RIGHTS_CHECKED
  REVIEWED
  PUBLISHED
  ARCHIVED
}

enum RightsType {
  ORIGINAL
  LICENSED
}

enum AssetKind {
  HERO
  CARD
  THUMB
  WALLPAPER
  AVATAR_FRAME
  PROFILE_THEME
  VOICE
  ASMR
  COMIC
}

enum AssetWorkflowStatus {
  UPLOADED
  NORMALIZED
  TAGGED
  RIGHTS_CHECKED
  REVIEWED
  PUBLISHED
  PULLED
}

enum AssetSourceKind {
  AI_GENERATED
  USER_PROVIDED
  BANGUMI_METADATA
  OFFICIAL_REFERENCE
}

enum CurrencyType {
  SOFT
  PREMIUM
}

enum LedgerReferenceType {
  STARTER_GRANT
  DAILY_REWARD
  AD_REWARD
  MISSION_REWARD
  WORK_REWARD
  BUY_SUPPORT
  SELL_SUPPORT
  SHOP_PURCHASE
}

enum CommentStatus {
  VISIBLE
  HELD
  REMOVED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MissionKey {
  COMFORT_SESSION
  POSITIVE_REACTION
  SUPPORT_OR_WATCH
}

enum WorkKind {
  SHIFT_30M
  SHIFT_2H
  SHIFT_6H
}

enum WorkStatus {
  ACTIVE
  READY
  CLAIMED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  REWARD
  TRADE
  SOCIAL
  SHOP
}

enum SourceKind {
  MANUAL
  BANGUMI
}

model User {
  id               String                 @id @default(cuid())
  email            String?                @unique
  name             String?
  image            String?
  role             UserRole               @default(USER)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  authIdentities   AuthIdentity[]
  sessions         Session[]
  profile          Profile?
  wallet           Wallet?
  positions        SupportPosition[]
  trades           Trade[]
  dailyRewards     DailyRewardClaim[]
  adRewards        AdRewardClaim[]
  watchlistItems   WatchlistItem[]
  comments         Comment[]
  reactions        Reaction[]
  reports          Report[]
  notifications    Notification[]
  inventoryItems   InventoryItem[]
  comfortSessions  ComfortSession[]
  comfortReactions ComfortReaction[]
  idempotency      IdempotencyRecord[]
  missionProgress  DailyMissionProgress[]
  workShifts       WorkShift[]
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  handle             String   @unique
  displayName        String
  bio                String
  holdingsVisibility Boolean  @default(true)
  favoriteTags       String[]
  pinnedCharacterIds String[]
  equippedFrameAsset String?
  equippedThemeAsset String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Series {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  summary      String
  rightsType   RightsType
  metadataOnly Boolean        @default(false)
  bangumiUrl   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  characters   Character[]
  rightsGrants RightsGrant[]
  locales      SeriesLocale[]
}

model SeriesLocale {
  id       String     @id @default(cuid())
  seriesId String
  locale   LocaleCode
  title    String
  summary  String
  series   Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, locale])
}

model Character {
  id                  String                    @id @default(cuid())
  seriesId            String
  slug                String                    @unique
  name                String
  title               String
  summary             String
  fandomPrompt        String
  mood                String
  rightsType          RightsType
  metadataOnly        Boolean                   @default(false)
  publishStatus       PublishStatus             @default(DRAFT)
  basePrice           Int
  priceStep           Int
  unitsPerStep        Int
  circulatingUnits    Int                       @default(0)
  supporterCount      Int                       @default(0)
  isFeatured          Boolean                   @default(false)
  accentFrom          String                    @default("#64748b")
  accentTo            String                    @default("#cbd5e1")
  relatedCharacterIds String[]                  @default([])
  releaseSeason       String?
  sourceTitle         String?
  favoritePhrase      String?
  externalScores      Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tags                CharacterTag[]            @relation("CharacterTags")
  series              Series                    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  attributes          CharacterAttributeValue[]
  assets              CharacterAsset[]
  sourceAttribution   SourceAttribution?
  rightsGrants        RightsGrant[]
  positions           SupportPosition[]
  trades              Trade[]
  comments            Comment[]
  reactions           Reaction[]
  reports             Report[]
  watchlistItems      WatchlistItem[]
  comfortContents     ComfortContent[]
  comfortSessions     ComfortSession[]
  locales             CharacterLocale[]
  workShifts          WorkShift[]
}

model CharacterLocale {
  id             String     @id @default(cuid())
  characterId    String
  locale         LocaleCode
  name           String
  title          String
  summary        String
  fandomPrompt   String
  mood           String
  favoritePhrase String?
  character      Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, locale])
}

model CharacterTag {
  id         String      @id @default(cuid())
  label      String      @unique
  characters Character[] @relation("CharacterTags")
}

model AttributeDefinition {
  id           String                      @id @default(cuid())
  key          String                      @unique
  label        String
  valueType    String
  filterable   Boolean                     @default(true)
  sortable     Boolean                     @default(false)
  displayable  Boolean                     @default(true)
  sensitive    Boolean                     @default(false)
  spoiler      Boolean                     @default(false)
  displayOrder Int                         @default(0)
  options      AttributeOption[]
  values       CharacterAttributeValue[]
  locales      AttributeDefinitionLocale[]
}

model AttributeDefinitionLocale {
  id           String              @id @default(cuid())
  definitionId String
  locale       LocaleCode
  label        String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, locale])
}

model AttributeOption {
  id           String              @id @default(cuid())
  definitionId String
  label        String
  value        String
  displayOrder Int                 @default(0)
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
}

model CharacterAttributeValue {
  id           String              @id @default(cuid())
  characterId  String
  definitionId String
  value        String
  character    Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, definitionId])
}

model CharacterAsset {
  id              String              @id @default(cuid())
  characterId     String?
  kind            AssetKind
  label           String
  storageKey      String
  altText         String
  workflowStatus  AssetWorkflowStatus @default(UPLOADED)
  publishedAt     DateTime?
  version         Int                 @default(1)
  metadata        Json?
  rightsGrantId   String?
  sourceKind      AssetSourceKind     @default(USER_PROVIDED)
  sourceUrl       String?
  attributionText String?
  takedownContact String?
  sourceLabel     String?
  licenseName     String?
  publicUrl       String?
  mimeType        String?
  byteSize        Int?
  aiPrompt        String?
  aiModel         String?
  character       Character?          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  rightsGrant     RightsGrant?        @relation(fields: [rightsGrantId], references: [id])
  comfortContents ComfortContent[]
}

model RightsGrant {
  id                String           @id @default(cuid())
  seriesId          String?
  characterId       String?
  licensor          String
  contractReference String
  territories       String[]
  salesChannels     String[]
  allowedUseTypes   String[]
  attributionText   String
  takedownContact   String
  embargoAt         DateTime?
  expiresAt         DateTime?
  commercialUse     Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  series            Series?          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  character         Character?       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  assets            CharacterAsset[]
}

model SourceAttribution {
  id              String     @id @default(cuid())
  characterId     String     @unique
  sourceKind      SourceKind
  sourceLabel     String
  sourceUrl       String
  licenseName     String
  attributionText String
  importedText    String?
  originalAuthor  String?
  importedAt      DateTime   @default(now())
  character       Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  softBalance    Int           @default(0)
  premiumBalance Int           @default(0)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]
}

model LedgerEntry {
  id             String              @id @default(cuid())
  walletId       String
  currencyType   CurrencyType
  delta          Int
  balanceAfter   Int
  referenceType  LedgerReferenceType
  referenceId    String
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  wallet         Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model SupportPosition {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  units       Int       @default(0)
  averageCost Int       @default(0)
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  side        String
  quantity    Int
  totalCost   Int
  unitPrice   Int
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model DailyRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  amount    Int
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

model AdRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  amount    Int
  slot      Int      @default(1)
  provider  String   @default("mock")
  proofId   String?
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey, slot])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Comment {
  id          String        @id @default(cuid())
  userId      String
  characterId String
  content     String
  status      CommentStatus @default(VISIBLE)
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  reports     Report[]
}

model Reaction {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  kind        String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId, kind])
}

model Report {
  id          String       @id @default(cuid())
  userId      String
  characterId String?
  commentId   String?
  reason      String
  detail      String?
  status      ReportStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)
  comment     Comment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopCollection {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  items       ShopItem[]
}

model ShopItem {
  id             String           @id @default(cuid())
  collectionId   String
  slug           String           @unique
  title          String
  description    String
  kind           AssetKind
  currencyType   CurrencyType
  price          Int
  previewLabel   String
  unlockPayload  Json
  published      Boolean          @default(true)
  collection     ShopCollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  locales        ShopItemLocale[]
}

model ShopItemLocale {
  id           String     @id @default(cuid())
  shopItemId   String
  locale       LocaleCode
  title        String
  description  String
  previewLabel String
  shopItem     ShopItem   @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([shopItemId, locale])
}

model InventoryItem {
  id         String   @id @default(cuid())
  userId     String
  shopItemId String
  equipped   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId])
}

model ComfortMode {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  subtitle    String
  description String
  promptLabel String
  accentFrom  String
  accentTo    String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  contents    ComfortContent[]
  locales     ComfortModeLocale[]
}

model ComfortModeLocale {
  id          String      @id @default(cuid())
  modeId      String
  locale      LocaleCode
  title       String
  subtitle    String
  description String
  promptLabel String
  mode        ComfortMode @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@unique([modeId, locale])
}

model ComfortContent {
  id               String                 @id @default(cuid())
  modeId           String
  characterId      String?
  kind             String
  title            String
  body             String
  mediaUrl         String?
  assetId          String?
  sweetnessLevel   Int                    @default(80)
  unlockShopItemId String?
  published        Boolean                @default(true)
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  mode             ComfortMode            @relation(fields: [modeId], references: [id], onDelete: Cascade)
  character        Character?             @relation(fields: [characterId], references: [id], onDelete: SetNull)
  asset            CharacterAsset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reactions        ComfortReaction[]
  locales          ComfortContentLocale[]
  comicPanels      ComicPanel[]
}

model ComfortContentLocale {
  id        String         @id @default(cuid())
  contentId String
  locale    LocaleCode
  title     String
  body      String
  content   ComfortContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, locale])
}

model ComicPanel {
  id        String             @id @default(cuid())
  contentId String
  sortOrder Int
  imageUrl  String
  altText   String
  content   ComfortContent     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  locales   ComicPanelLocale[]

  @@unique([contentId, sortOrder])
}

model ComicPanelLocale {
  id      String     @id @default(cuid())
  panelId String
  locale  LocaleCode
  caption String
  panel   ComicPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, locale])
}

model ComfortSession {
  id          String     @id @default(cuid())
  userId      String
  modeSlug    String
  characterId String?
  note        String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
}

model ComfortReaction {
  id        String          @id @default(cuid())
  userId    String
  modeSlug  String
  contentId String?
  kind      String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   ComfortContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
}

model IdempotencyRecord {
  id          String    @id @default(cuid())
  userId      String
  scope       String
  key         String
  requestHash String
  response    Json?
  completedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model DailyMissionProgress {
  id          String     @id @default(cuid())
  userId      String
  dayKey      String
  missionKey  MissionKey
  reward      Int
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey, missionKey])
}

model WorkShift {
  id          String     @id @default(cuid())
  userId      String
  characterId String?
  dayKey      String
  kind        WorkKind
  status      WorkStatus @default(ACTIVE)
  reward      Int
  startedAt   DateTime   @default(now())
  endsAt      DateTime
  claimedAt   DateTime?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([userId, dayKey])
  @@index([userId, status])
}
