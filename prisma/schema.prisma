generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum LocaleCode {
  EN
  ZH_HANT
}

enum PublishStatus {
  DRAFT
  RIGHTS_CHECKED
  REVIEWED
  PUBLISHED
  ARCHIVED
}

enum RightsType {
  ORIGINAL
  LICENSED
}

enum AssetKind {
  HERO
  CARD
  THUMB
  WALLPAPER
  AVATAR_FRAME
  PROFILE_THEME
  VOICE
  ASMR
  COMIC
}

enum AssetWorkflowStatus {
  UPLOADED
  NORMALIZED
  TAGGED
  RIGHTS_CHECKED
  REVIEWED
  PUBLISHED
  PULLED
}

enum AssetSourceKind {
  PLATFORM_ORIGINAL
  AI_GENERATED
  USER_PROVIDED
  FAN_ART
  OPEN_LICENSE
  BANGUMI_METADATA
  OFFICIAL_REFERENCE
}

enum AssetPermissionStatus {
  VERIFIED
  CREATOR_GRANTED
  UNVERIFIED
  REJECTED
  TAKEDOWN_REQUESTED
}

enum ContentRating {
  UNRATED
  SFW
  SUGGESTIVE
  NSFW
}

enum AssetDerivativeKind {
  THUMBNAIL
  CARD
  HERO
  WALLPAPER
}

enum AssetAuditAction {
  CREATED
  METADATA_UPDATED
  RIGHTS_REVIEWED
  PUBLISHED
  PULLED
  TAKEDOWN_REQUESTED
  TAKEDOWN_RESOLVED
}

enum TakedownStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum TradeSide {
  BUY
  SELL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CampaignRewardKind {
  BADGE
  SHOP_ITEM
  COMFORT_CONTENT
}

enum MarketAlertKind {
  QUOTE_ABOVE
  QUOTE_BELOW
  CAMPAIGN_MILESTONE
  SUPPORT_ACTIVITY
}

enum CurrencyType {
  SOFT
  PREMIUM
}

enum LedgerReferenceType {
  STARTER_GRANT
  DAILY_REWARD
  AD_REWARD
  MISSION_REWARD
  WORK_REWARD
  BUY_SUPPORT
  SELL_SUPPORT
  SHOP_PURCHASE
  PREDICTION_BUY
  PREDICTION_SELL
  PREDICTION_FEE
  PREDICTION_PAYOUT
  PREDICTION_REFUND
}

enum CommentStatus {
  VISIBLE
  HELD
  REMOVED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MissionKey {
  COMFORT_SESSION
  POSITIVE_REACTION
  SUPPORT_OR_WATCH
}

enum WorkKind {
  SHIFT_30M
  SHIFT_2H
  SHIFT_6H
}

enum WorkStatus {
  ACTIVE
  READY
  CLAIMED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  REWARD
  TRADE
  SOCIAL
  SHOP
}

enum SourceKind {
  MANUAL
  BANGUMI
}

enum PostKind {
  NOTE
  OUTFIT
  COMIC
  VOICE
  GUIDE
  PREDICTION_TAKE
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HELD
  REMOVED
}

enum PostMediaStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PULLED
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

enum LibraryStatus {
  WANT
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

enum EpisodeProgressStatus {
  PLANNED
  WATCHED
  SKIPPED
}

enum EntityType {
  SERIES
  CHARACTER
  PERSON
  EPISODE
  POST
}

enum EditProposalStatus {
  DRAFT
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum ReviewDecisionKind {
  REQUEST_CHANGES
  APPROVE
  REJECT
}

enum ContributorTrustKind {
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  REVISION_REVERTED
  SOURCE_VERIFIED
  MODERATION_ACTION
}

enum PredictionMarketStatus {
  DRAFT
  OPEN
  LOCKED
  PROPOSED
  CHALLENGE
  RESOLVED
  VOID
}

enum PredictionTradeSide {
  BUY
  SELL
}

enum PredictionResolutionStatus {
  PROPOSED
  CHALLENGED
  CONFIRMED
  VOIDED
}

model User {
  id                     String                      @id @default(cuid())
  email                  String?                     @unique
  name                   String?
  image                  String?
  role                   UserRole                    @default(USER)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  authIdentities         AuthIdentity[]
  sessions               Session[]
  profile                Profile?
  wallet                 Wallet?
  positions              SupportPosition[]
  trades                 Trade[]
  dailyRewards           DailyRewardClaim[]
  adRewards              AdRewardClaim[]
  watchlistItems         WatchlistItem[]
  comments               Comment[]
  reactions              Reaction[]
  reports                Report[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  analyticsEvents        AnalyticsEvent[]
  inventoryItems         InventoryItem[]
  comfortSessions        ComfortSession[]
  comfortReactions       ComfortReaction[]
  idempotency            IdempotencyRecord[]
  missionProgress        DailyMissionProgress[]
  workShifts             WorkShift[]
  campaignContributions  CampaignContribution[]
  marketAlerts           MarketAlert[]
  assetAuditLogs         AssetAuditLog[]
  takedownRequests       TakedownRequest[]
  posts                  Post[]                      @relation("PostAuthor")
  postSaves              PostSave[]
  postReactions          PostReaction[]
  followingUsers         UserFollow[]                @relation("UserFollowFollower")
  followers              UserFollow[]                @relation("UserFollowTarget")
  characterFollows       CharacterFollow[]
  topicFollows           TopicFollow[]
  collections            Collection[]
  creatorProfile         CreatorProfile?
  creatorSeries          CreatorSeries[]
  creatorSubscriptions   CreatorSeriesSubscription[]
  libraryEntries         LibraryEntry[]
  episodeProgress        EpisodeProgress[]
  ratings                UserRating[]
  curatedLists           CuratedList[]
  editProposals          EditProposal[]              @relation("EditProposalAuthor")
  reviewDecisions        ReviewDecision[]            @relation("ReviewDecisionReviewer")
  trustEvents            ContributorTrustEvent[]     @relation("TrustEventUser")
  authoredTrustEvents    ContributorTrustEvent[]     @relation("TrustEventActor")
  predictionPositions    PredictionPosition[]
  predictionTrades       PredictionTrade[]
  resolutionProposals    ResolutionProposal[]        @relation("ResolutionProposer")
  resolutionChallenges   ResolutionChallenge[]
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                    String     @id @default(cuid())
  userId                String     @unique
  handle                String     @unique
  displayName           String
  bio                   String
  holdingsVisibility    Boolean    @default(true)
  favoriteTags          String[]
  pinnedCharacterIds    String[]
  equippedFrameAsset    String?
  equippedThemeAsset    String?
  onboardingCompletedAt DateTime?
  preferredLocale       LocaleCode @default(EN)
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Series {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  summary        String
  rightsType     RightsType
  metadataOnly   Boolean           @default(false)
  bangumiUrl     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  characters     Character[]
  rightsGrants   RightsGrant[]
  locales        SeriesLocale[]
  posts          Post[]
  episodes       Episode[]
  libraryEntries LibraryEntry[]
  ratings        UserRating[]
  curatedItems   CuratedListItem[]
}

model SeriesLocale {
  id       String     @id @default(cuid())
  seriesId String
  locale   LocaleCode
  title    String
  summary  String
  series   Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, locale])
}

model Character {
  id                  String                    @id @default(cuid())
  seriesId            String
  slug                String                    @unique
  name                String
  title               String
  summary             String
  fandomPrompt        String
  mood                String
  rightsType          RightsType
  metadataOnly        Boolean                   @default(false)
  publishStatus       PublishStatus             @default(DRAFT)
  basePrice           Int
  priceStep           Int
  unitsPerStep        Int
  circulatingUnits    Int                       @default(0)
  supporterCount      Int                       @default(0)
  marketVersion       Int                       @default(0)
  isFeatured          Boolean                   @default(false)
  accentFrom          String                    @default("#64748b")
  accentTo            String                    @default("#cbd5e1")
  relatedCharacterIds String[]                  @default([])
  releaseSeason       String?
  sourceTitle         String?
  favoritePhrase      String?
  externalScores      Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tags                CharacterTag[]            @relation("CharacterTags")
  series              Series                    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  attributes          CharacterAttributeValue[]
  assets              CharacterAsset[]
  sourceAttribution   SourceAttribution?
  rightsGrants        RightsGrant[]
  positions           SupportPosition[]
  trades              Trade[]
  comments            Comment[]
  reactions           Reaction[]
  reports             Report[]
  watchlistItems      WatchlistItem[]
  comfortContents     ComfortContent[]
  comfortSessions     ComfortSession[]
  locales             CharacterLocale[]
  workShifts          WorkShift[]
  supportCampaigns    SupportCampaign[]
  marketAlerts        MarketAlert[]
  posts               Post[]
  followers           CharacterFollow[]
  collectionItems     CollectionItem[]
  curatedItems        CuratedListItem[]
}

model CharacterLocale {
  id             String     @id @default(cuid())
  characterId    String
  locale         LocaleCode
  name           String
  title          String
  summary        String
  fandomPrompt   String
  mood           String
  favoritePhrase String?
  character      Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, locale])
}

model CharacterTag {
  id         String      @id @default(cuid())
  label      String      @unique
  characters Character[] @relation("CharacterTags")
}

model AttributeDefinition {
  id           String                      @id @default(cuid())
  key          String                      @unique
  label        String
  valueType    String
  filterable   Boolean                     @default(true)
  sortable     Boolean                     @default(false)
  displayable  Boolean                     @default(true)
  sensitive    Boolean                     @default(false)
  spoiler      Boolean                     @default(false)
  displayOrder Int                         @default(0)
  options      AttributeOption[]
  values       CharacterAttributeValue[]
  locales      AttributeDefinitionLocale[]
}

model AttributeDefinitionLocale {
  id           String              @id @default(cuid())
  definitionId String
  locale       LocaleCode
  label        String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, locale])
}

model AttributeOption {
  id           String              @id @default(cuid())
  definitionId String
  label        String
  value        String
  displayOrder Int                 @default(0)
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
}

model CharacterAttributeValue {
  id           String              @id @default(cuid())
  characterId  String
  definitionId String
  value        String
  character    Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, definitionId])
}

model CharacterAsset {
  id                   String                 @id @default(cuid())
  characterId          String?
  kind                 AssetKind
  label                String
  storageKey           String
  altText              String
  workflowStatus       AssetWorkflowStatus    @default(UPLOADED)
  publishedAt          DateTime?
  version              Int                    @default(1)
  metadata             Json?
  rightsGrantId        String?
  sourceKind           AssetSourceKind        @default(USER_PROVIDED)
  sourceUrl            String?
  attributionText      String?
  takedownContact      String?
  sourceLabel          String?
  licenseName          String?
  publicUrl            String?
  mimeType             String?
  byteSize             Int?
  aiPrompt             String?
  aiModel              String?
  permissionStatus     AssetPermissionStatus  @default(UNVERIFIED)
  contentRating        ContentRating          @default(UNRATED)
  creatorName          String?
  creatorUrl           String?
  originalMediaUrl     String?
  licenseUrl           String?
  permissionEvidence   String?
  commercialUseAllowed Boolean                @default(false)
  adaptationAllowed    Boolean                @default(false)
  retrievedAt          DateTime?
  checksum             String?                @unique
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNotes          String?
  riskAcknowledgedById String?
  riskAcknowledgedAt   DateTime?
  primaryPriority      Int                    @default(0)
  character            Character?             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  rightsGrant          RightsGrant?           @relation(fields: [rightsGrantId], references: [id])
  comfortContents      ComfortContent[]
  derivatives          AssetDerivative[]
  locales              CharacterAssetLocale[]
  auditLogs            AssetAuditLog[]
  takedownRequests     TakedownRequest[]
  postMedia            PostMedia[]
  collectionItems      CollectionItem[]

  @@index([characterId, workflowStatus, primaryPriority])
  @@index([permissionStatus, contentRating])
}

model AssetDerivative {
  id         String              @id @default(cuid())
  assetId    String
  kind       AssetDerivativeKind
  storageKey String
  publicUrl  String
  mimeType   String
  width      Int
  height     Int
  byteSize   Int
  checksum   String              @unique
  createdAt  DateTime            @default(now())
  asset      CharacterAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind])
}

model CharacterAssetLocale {
  id              String         @id @default(cuid())
  assetId         String
  locale          LocaleCode
  altText         String
  caption         String?
  attributionText String?
  asset           CharacterAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, locale])
}

model AssetAuditLog {
  id          String           @id @default(cuid())
  assetId     String
  actorUserId String?
  action      AssetAuditAction
  detail      Json?
  createdAt   DateTime         @default(now())
  asset       CharacterAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor       User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
}

model TakedownRequest {
  id              String         @id @default(cuid())
  assetId         String
  requesterUserId String?
  requesterName   String?
  requesterEmail  String
  reason          String
  evidenceUrl     String?
  status          TakedownStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  asset           CharacterAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requester       User?          @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)

  @@index([assetId, status])
  @@index([status, createdAt])
}

model RightsGrant {
  id                String           @id @default(cuid())
  seriesId          String?
  characterId       String?
  licensor          String
  contractReference String
  territories       String[]
  salesChannels     String[]
  allowedUseTypes   String[]
  attributionText   String
  takedownContact   String
  embargoAt         DateTime?
  expiresAt         DateTime?
  commercialUse     Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  series            Series?          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  character         Character?       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  assets            CharacterAsset[]
}

model SourceAttribution {
  id              String     @id @default(cuid())
  characterId     String     @unique
  sourceKind      SourceKind
  sourceLabel     String
  sourceUrl       String
  licenseName     String
  attributionText String
  importedText    String?
  originalAuthor  String?
  importedAt      DateTime   @default(now())
  character       Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  softBalance    Int           @default(0)
  premiumBalance Int           @default(0)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]
}

model LedgerEntry {
  id             String              @id @default(cuid())
  walletId       String
  currencyType   CurrencyType
  delta          Int
  balanceAfter   Int
  referenceType  LedgerReferenceType
  referenceId    String
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  wallet         Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model SupportPosition {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  units       Int       @default(0)
  averageCost Int       @default(0)
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Trade {
  id               String    @id @default(cuid())
  userId           String
  characterId      String
  side             TradeSide
  quantity         Int
  totalCost        Int
  unitPrice        Int
  quoteBefore      Int
  quoteAfter       Int
  supplyBefore     Int
  supplyAfter      Int
  firstUnitPrice   Int
  lastUnitPrice    Int
  averageUnitPrice Int
  marketVersion    Int
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@index([characterId, side, createdAt])
}

model SupportCampaign {
  id            String                  @id @default(cuid())
  characterId   String
  slug          String                  @unique
  status        CampaignStatus          @default(DRAFT)
  title         String
  description   String
  goalUnits     Int
  currentUnits  Int                     @default(0)
  startsAt      DateTime
  endsAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  character     Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  locales       SupportCampaignLocale[]
  contributions CampaignContribution[]
  rewards       SupportCampaignReward[]

  @@index([status, startsAt, endsAt])
  @@index([characterId, status])
}

model SupportCampaignLocale {
  id          String          @id @default(cuid())
  campaignId  String
  locale      LocaleCode
  title       String
  description String
  campaign    SupportCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locale])
}

model CampaignContribution {
  id                String          @id @default(cuid())
  campaignId        String
  userId            String
  units             Int             @default(0)
  badgeLevel        Int             @default(0)
  lastContributedAt DateTime        @default(now())
  createdAt         DateTime        @default(now())
  campaign          SupportCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, lastContributedAt])
}

model SupportCampaignReward {
  id             String             @id @default(cuid())
  campaignId     String
  thresholdUnits Int
  kind           CampaignRewardKind
  label          String
  referenceId    String?
  campaign       SupportCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, thresholdUnits, kind])
}

model MarketAlert {
  id              String          @id @default(cuid())
  userId          String
  characterId     String
  kind            MarketAlertKind
  thresholdValue  Int?
  active          Boolean         @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  character       Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId, kind, thresholdValue])
  @@index([characterId, active, kind])
  @@index([userId, active])
}

model DailyRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  amount    Int
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

model AdRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  amount    Int
  slot      Int      @default(1)
  provider  String   @default("mock")
  proofId   String?
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey, slot])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Comment {
  id                 String            @id @default(cuid())
  userId             String
  characterId        String?
  postId             String?
  predictionMarketId String?
  parentId           String?
  content            String
  status             CommentStatus     @default(VISIBLE)
  pinnedByAuthor     Boolean           @default(false)
  heartedByAuthor    Boolean           @default(false)
  updatedAt          DateTime          @updatedAt
  createdAt          DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  character          Character?        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  post               Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  predictionMarket   PredictionMarket? @relation(fields: [predictionMarketId], references: [id], onDelete: Cascade)
  parent             Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies            Comment[]         @relation("CommentReplies")
  reports            Report[]

  @@index([postId, status, createdAt])
  @@index([predictionMarketId, status, createdAt])
  @@index([parentId, createdAt])
}

model Reaction {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  kind        String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId, kind])
}

model Report {
  id          String       @id @default(cuid())
  userId      String
  characterId String?
  commentId   String?
  postId      String?
  reason      String
  detail      String?
  status      ReportStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)
  comment     Comment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  href      String?
  locale    LocaleCode?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  followedContent   Boolean  @default(true)
  seriesUpdates     Boolean  @default(true)
  predictionChanges Boolean  @default(true)
  predictionClosing Boolean  @default(true)
  resolutions       Boolean  @default(true)
  moderationResults Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id         String      @id @default(cuid())
  userId     String?
  sessionKey String?
  name       String
  locale     LocaleCode?
  path       String?
  referrer   String?
  source     String?
  metadata   Json?
  createdAt  DateTime    @default(now())
