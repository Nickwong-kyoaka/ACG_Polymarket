DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acg_polymarket?schema=public"
# Tests never use DATABASE_URL. Point this only at a disposable *_test database.
TEST_DATABASE_URL=""
# Local migration generation only; Render does not need this variable.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acg_shadow?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-the-same-value-as-auth-secret"
NEXTAUTH_URL="http://localhost:3000"
# Required behind Render or another trusted reverse proxy.
AUTH_TRUST_HOST="false"
MARKET_QUOTE_SECRET="replace-with-a-separate-random-secret"
# V3 public-entry flags. Turn submissions off independently during moderation incidents.
FEATURE_COMMUNITY="true"
FEATURE_PREDICTIONS="true"
FEATURE_SUBMISSIONS="true"
ADMIN_EMAILS="admin@example.com"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
BANGUMI_USER_AGENT="ACG_Polymarket/0.1 (+https://github.com/Nickwong-kyoaka/ACG_Polymarket)"
ADS_PROVIDER="mock"
GOOGLE_AD_CLIENT=""
S3_BUCKET="acg-polymarket-assets"
# Required for external post images; must differ from S3_BUCKET and remain non-public.
# Keep public bucket/CDN policies away from this bucket. The app serves approved bytes.
# Operator/provider policy enforces privacy; uploads do not send object ACLs.
S3_PRIVATE_BUCKET="acg-polymarket-post-media-private"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"
# Production-safe defaults. Local Docker overrides these for demo access.
DEMO_MODE="false"
DEMO_ADMIN_ENABLED="false"
DEMO_USER_ID="viewer-001"
# One-off guarded reset only; never leave enabled on Render.
ALLOW_BETA_RESET="false"
